filters:
  and:
    - file.ext == "md"
    - file.name != "index"
views:
  - type: table
    name: By tag
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: All notes
    order:
      - file.name
      - file.tags
      - file.folder
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
